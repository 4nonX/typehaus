# typehaus settings – copy to .env (Dockge: paste into the stack's .env editor)

# ── Required ────────────────────────────────────────────────────────────────
# Public address of typehaus, exactly as users and the desktop app reach it.
# Use https:// behind a reverse proxy. No trailing slash.
TYPEHAUS_BASE_URL=https://fonts.example.com

# ── First start ─────────────────────────────────────────────────────────────
# Initial administrator. Only used when the database is created.
# Leave the password empty to have a random one printed in the container log.
TYPEHAUS_ADMIN_USER=admin
TYPEHAUS_ADMIN_PASSWORD=

# ── Container ───────────────────────────────────────────────────────────────
# Image tag: "latest", a release like "0.2.0", or "edge" (newest main build)
TYPEHAUS_VERSION=latest
# Port on the host, and the interface to bind (127.0.0.1 = only reachable
# through a reverse proxy on this host)
TYPEHAUS_PORT=8080
TYPEHAUS_BIND=0.0.0.0

# ── Behaviour ───────────────────────────────────────────────────────────────
# true when a reverse proxy sets X-Forwarded-For / X-Forwarded-Proto.
# Set to false if typehaus is exposed directly.
TYPEHAUS_TRUST_PROXY=true
# How often computers check for changes, in seconds (min. 10)
TYPEHAUS_POLL_SECONDS=60
# Max size of one upload request in MB (raise your proxy's limit to match)
TYPEHAUS_MAX_UPLOAD_MB=512
# Let users download font files to install them themselves (admins always can).
# Downloaded copies are outside typehaus' control – revoking access doesn't remove them.
TYPEHAUS_DOWNLOADS=true
# Web session lifetime in hours
TYPEHAUS_SESSION_HOURS=168
# Ask the apps to report, once a day, fonts installed outside typehaus
# (names and checksums, never the files). Tell your users first.
TYPEHAUS_INVENTORY=false
# API requests per token and minute
TYPEHAUS_API_RATE=600

# ── Find fonts ──────────────────────────────────────────────────────────────
# Free font catalog (Google Fonts, Font Squirrel, Fontsource) and font
# identification from images. Both need internet access from the server;
# set false for air-gapped installations.
TYPEHAUS_CATALOG=true
TYPEHAUS_IDENTIFY=true
# API keys of identification services (optional). Administrators can also
# enter them under Integrations → Services; these take precedence.
TYPEHAUS_WHATFONTIS_KEY=
TYPEHAUS_MIXFONT_KEY=
TYPEHAUS_ASPOSE_CLIENT_ID=
TYPEHAUS_ASPOSE_CLIENT_SECRET=

# ── Single sign-on (optional) ───────────────────────────────────────────────
# Any OpenID Connect provider: Authentik, Keycloak, Authelia, Zitadel,
# Pocket ID, Entra ID, Google … Redirect URI to register at the provider:
#   ${TYPEHAUS_BASE_URL}/auth/oidc/callback
TYPEHAUS_OIDC_ISSUER=
TYPEHAUS_OIDC_CLIENT_ID=
TYPEHAUS_OIDC_CLIENT_SECRET=
# Label of the login button, e.g. "Authentik"
TYPEHAUS_OIDC_NAME=
# Claim with group names (usually "groups"); typehaus groups with the same
# name are assigned at every login
TYPEHAUS_OIDC_GROUPS_CLAIM=
# Members of this identity-provider group become typehaus administrators
TYPEHAUS_OIDC_ADMIN_GROUP=
# Create accounts on first SSO login (false: only pre-created users)
TYPEHAUS_OIDC_AUTO_CREATE=true
# Allow username/password login. false = SSO only; then
# TYPEHAUS_OIDC_GROUPS_CLAIM and TYPEHAUS_OIDC_ADMIN_GROUP are required.
TYPEHAUS_LOCAL_LOGIN=true
